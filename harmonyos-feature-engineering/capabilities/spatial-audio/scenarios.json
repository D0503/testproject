      ],
      "criteriaSpec": {
        "required": [
          {
            "topic": "管理器获取入口",
            "hint": "从本次冻结官网现提 audioManager.getSpatializationManager 的 API 版本门槛、返回类型与唯一入口语义（使用前需先 getAudioManager 获取 AudioManager 实例）。",
            "mustResolve": true
          },
          {
            "topic": "设备空间音频能力判断",
            "hint": "现提 AudioDeviceDescriptor.spatializationSupported 的获取路径（经 getRoutingManager 与 getDevicesSync 取设备描述符）与判断语义。",
            "mustResolve": true
          },
          {
            "topic": "开关状态查询",
            "hint": "现提 isSpatializationEnabledForCurrentDevice 的同步返回语义（true 开启 / false 未开启）与适用范围。",
            "mustResolve": true
          },
          {
            "topic": "状态订阅与取消",
            "hint": "现提 on/off('spatializationEnabledChangeForCurrentDevice') 的回调参数语义与取消粒度（同 callback 取消单个、不传取消全部）。",
            "mustResolve": true
          },
          {
            "topic": "开关状态与实际生效的关系",
            "hint": "现提“开关状态仅为开关，实际生效还依赖设备支持空间音频渲染”的约束，实施结论不得把开关 true 表述为渲染已生效。",
            "mustResolve": true
          },
          {
            "topic": "错误码与参数校验",
            "hint": "现提 6800101 Parameter verification failed 的触发条件与处理方式（详见错误码参考），查询/订阅失败不得被吞掉。",
            "mustResolve": true
          },
          {
            "topic": "Kit设备支持范围前提",
            "hint": "Audio Kit 目录页标注的设备支持范围（Kit 级）仅作前提，实际能力以 spatializationSupported 查询结果为准，二者口径差异需保留。",
            "mustResolve": true
          },
          {
            "topic": "范围边界：开关设置接口",
            "hint": "本批确认资料仅含查询与订阅接口：如实施涉及空间音频渲染开关的设置行为，须另行确认官网资料，不得基于接口命名臆造设置能力。",
            "mustResolve": true
          }
        ],
        "conflictProbes": [
          {
            "id": "SA-S004-P01",
            "topic": "开关状态与设备能力口径差异",
            "positions": [
              "能力查询指南：开关状态仅为开关，实际生效还依赖设备支持空间音频渲染（spatializationSupported）",
              "接口页：isSpatializationEnabledForCurrentDevice 仅返回当前设备空间音频渲染效果开关 true/false",
              "现提时须对两个口径分别给结论，不得把开关查询结果当作渲染生效证明"
            ]
          },
          {
            "id": "SA-S004-P02",
            "topic": "设置类接口缺失边界",
            "positions": [
              "本批确认资料（能力查询指南、AudioSpatializationManager 与 AudioManager 接口页）只出现查询与订阅接口",
              "若需求要求开/关设置能力，现提时须核对官网是否存在对应接口；本能力包范围内按未覆盖处理，不得推断存在"
            ]
          }
        ]
      },
      "expectedOutcomeTemplates": [
        {
          "assertion": "在支持空间音频的设备上：spatializationSupported 反映设备能力，isSpatializationEnabledForCurrentDevice 返回当前开关状态；查询失败时按错误码路径记录，不返回伪结果。",
          "criteriaTopics": [
            "管理器获取入口",
            "设备空间音频能力判断",
            "开关状态查询",
            "错误码与参数校验"
          ]
        },
        {
          "assertion": "订阅期间开关状态变化触发 on('spatializationEnabledChangeForCurrentDevice') 回调并给出 true/false；off 传入与 on 相同的 callback 仅取消该监听、不传取消全部，无泄漏的重复回调。",
          "criteriaTopics": [
            "状态订阅与取消",
            "管理器获取入口",
            "错误码与参数校验"
          ]
        },
        {
          "assertion": "设备不支持空间音频渲染时，能力查询结论与开关状态分开呈现，实施不宣称空间音频已生效；Kit 级设备范围仅作为前提说明。",
          "criteriaTopics": [
            "开关状态与实际生效的关系",
            "设备空间音频能力判断",
            "Kit设备支持范围前提",
            "范围边界：开关设置接口"
          ]
        }
      ],
      "implementation": {
        "steps": [
          "先 getAudioManager 获取 AudioManager，再调用 getSpatializationManager 获取 AudioSpatializationManager 实例，API 门槛按本次冻结判据核对。",
          "设备能力判断按指南路径经 getRoutingManager().getDevicesSync() 获取 AudioDeviceDescriptor 后读取 spatializationSupported。",
          "调用 isSpatializationEnabledForCurrentDevice 查询开关状态，结论仅表述为开关状态，与设备能力分开呈现。",
          "订阅与取消成对实现：on 注册 callback，off 传入同一 callback 取消单个监听、不传取消该事件全部订阅。",
          "捕获并记录 6800101 等参数校验失败，不做静默降级。",
          "仅实现查询与订阅；不实现任何空间音频渲染开关的设置行为（本批资料未提供）。"
        ]
      },
