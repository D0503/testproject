      "displayName": "C/C++ OHAudioSuite 空间渲染",
      "status": "ready",
      "projectRequirements": {
        "model": "stage",
        "minCompileApi": 23,
        "minTargetApi": 23,
        "minCompatibleApi": null,
        "compatibleApiMayBeLower": true,
        "compatibilityPolicy": "OHAudioSuite 引擎/管线基础接口起始 API 22；空间渲染节点 EFFECT_NODE_TYPE_SPACE_RENDER 与固定摆位/旋转/扩展三模式参数接口起始 API 23；HOA 空间渲染节点起始 26.0.0；REALTIME 模式在 API 23 前仅支持均衡器效果节点。CMake 需链接 libohaudio.so 与 libohaudiosuite.so，头文件 ohaudiosuite/native_audio_suite_base.h、native_audio_suite_engine.h 及 ohaudio 相关头。各版本门槛与数量限制以每轮冻结的华为开发者官网为准，不得仅凭能力名称推断兼容版本。"
      },
      "sdk": {
        "preferredApi": 23,
        "validatedLocalVersion": null,
        "requiredDeclarationGlobs": [
          "openharmony/**/ohaudiosuite/native_audio_suite_base.h",
          "openharmony/**/ohaudiosuite/native_audio_suite_engine.h",
          "openharmony/**/ohaudio/native_audiorenderer.h"
        ],
        "requiredSymbols": [
          "EFFECT_NODE_TYPE_SPACE_RENDER",
          "OH_AudioSuiteEngine_SetSpaceRenderPositionParams"
        ]
      },
      "supportedTargets": {
        "engine": [
          "OH_AudioSuiteEngine"
        ],
        "node": [
          "EFFECT_NODE_TYPE_SPACE_RENDER",
          "EFFECT_NODE_TYPE_HOA_SPACE_RENDER"
        ],
        "params": [
          "OH_AudioSuite_SpaceRenderPositionParams",
          "OH_AudioSuite_SpaceRenderRotationParams",
          "OH_AudioSuite_SpaceRenderExtensionParams"
        ]
      },
      "intentPatterns": [
        "空间音频渲染",
        "空间渲染",
        "OHAudioSuite",
        "SpaceRender",
        "HOA"
      ]
    },
    {
      "id": "route-arkts-spatialization",
      "displayName": "ArkTS 空间音频管理与状态订阅",
      "status": "ready",
      "projectRequirements": {
        "model": "stage",
        "minCompileApi": 18,
        "minTargetApi": 18,
        "minCompatibleApi": null,
        "compatibleApiMayBeLower": true,
        "compatibilityPolicy": "基于 @kit.AudioKit（SystemCapability.Multimedia.Audio.Spatialization）；getSpatializationManager 与 AudioSpatializationManager 本批查询/订阅接口均起始 API 18，实例唯一获取入口为 audioManager.getSpatializationManager()。开关状态仅为开关，实际渲染生效还依赖设备支持空间音频渲染。设备支持范围与版本以每轮冻结的华为开发者官网为准。"
      },
      "sdk": {
        "preferredApi": 18,
        "validatedLocalVersion": null,
        "requiredDeclarationGlobs": [
          "openharmony/ets/api/@ohos.audio.d.ts"
        ],
        "requiredSymbols": [
          "getSpatializationManager",
          "AudioSpatializationManager"
        ]
      },
      "supportedTargets": {
        "manager": [
          "getSpatializationManager",
          "AudioSpatializationManager"
        ],
        "query": [
          "isSpatializationEnabledForCurrentDevice",
          "spatializationSupported"
        ],
        "subscribe": [
          "spatializationEnabledChangeForCurrentDevice"
        ]
      },
      "intentPatterns": [
        "空间音频查询",
        "空间音频开关",
        "空间音频订阅",
        "AudioSpatializationManager",
        "spatializationSupported"
      ]
    }
  ],
