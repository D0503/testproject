      "expectPage": "沉浸光感"
    },
    {
      "stepId": "wait-render",
      "action": "wait",
      "timeoutMs": 2000
    },
    {
      "stepId": "swipe-mid",
      "action": "swipe",
      "from": [628, 2200],
      "to": [628, 600]
