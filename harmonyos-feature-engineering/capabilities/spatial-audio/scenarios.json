  "scenarios": [
    {
      "id": "SA-S001",
      "displayName": "C/C++ 空间渲染管线构建与实时预览",
      "route": "route-native-audiosuite",
      "intentPatterns": [
        "空间音频渲染",
        "空间渲染管线",
        "空间渲染节点",
        "实时预览",
        "OHAudioSuite",
        "CreatePipeline",
        "StartPipeline",
        "StopPipeline",
        "RenderFrame",
        "AUDIOSUITE_PIPELINE_REALTIME_MODE"
      ],
      "intentGroups": [
        [
          "空间渲染",
          "管线"
        ],
        [
          "OHAudioSuite",
          "实时预览"
        ],
        [
          "空间音频",
          "C/C++"
        ]
      ],
      "intentPriority": 1,
      "targets": [
        "OH_AudioSuiteEngine",
        "EFFECT_NODE_TYPE_SPACE_RENDER",
        "OH_AudioSuiteNodeBuilder",
        "AUDIOSUITE_PIPELINE_REALTIME_MODE"
      ],
      "sources": [
        "doc-a39fa6bbea740bd3d1d6",
        "doc-cff945c0dd065743c215",
        "doc-bf8367192ded3960290d",
        "doc-af1253fea5b36efa0479"
      ],
      "criteriaSpec": {
        "required": [
          {
            "topic": "引擎与管线生命周期顺序",
            "hint": "核对本次冻结官网给出的流程：OH_AudioSuiteEngine_Create → CreatePipeline（空间渲染预览用 AUDIOSUITE_PIPELINE_REALTIME_MODE）→ 创建节点并组网 → StartPipeline/StopPipeline → 依次销毁节点、管线、引擎；核对引擎销毁是否级联销毁全部管线。",
            "mustResolve": true
          },
          {
            "topic": "节点创建与连接组网",
            "hint": "核对 NodeBuilder（Create/SetNodeType/SetFormat/SetRequestDataCallback/Destroy）构建输入（含数据回调）、EFFECT_NODE_TYPE_SPACE_RENDER、混音（EFFECT_NODE_TYPE_AUDIO_MIXER）与输出节点的方式，以及 CreateNode 后经 ConnectNodes 按官方拓扑连接、DisconnectNodes 的使用条件。",
            "mustResolve": true
          },
          {
            "topic": "实时预览链路与 finishedFlag 语义",
            "hint": "核对输出节点经 OH_AudioRenderer 写数据回调结合 OH_AudioSuiteEngine_RenderFrame 的实时预览链路；requestFrameSize 需大于 0、responseSize 不超过请求大小；全部输入提交完成后 finishedFlag 置位，此后不得再调用 RenderFrame。",
            "mustResolve": true
          },
          {
            "topic": "构建链接与头文件引入",
            "hint": "核对 CMake 链接 libohaudio.so 与 libohaudiosuite.so，头文件 ohaudiosuite/native_audio_suite_base.h、native_audio_suite_engine.h 及 ohaudio/native_audiorenderer.h、native_audiostreambuilder.h 的引入方式。",
            "mustResolve": true
          },
          {
            "topic": "REALTIME 模式与版本门槛",
            "hint": "核对空间渲染能力起始 API version 23；REALTIME 模式在 API 23 前仅支持均衡器效果节点、API 23 及以后支持全部效果节点；EDIT 与 REALTIME 模式差异以本次冻结官网为准。",
            "mustResolve": true
          },
          {
            "topic": "管线与节点数量拓扑限制",
            "hint": "核对每引擎管线数量上限、实时预览管线的版本分档限制、每管线输入/输出节点数量要求（有且仅 1 个输出）、混音节点上限、输入与效果节点数量的版本分档上限及超限错误码。",
            "mustResolve": true
          },
          {
            "topic": "销毁前置条件",
            "hint": "核对 DestroyNode 须管线处于 STOPPED 且节点不在处理路径、NodeBuilder 用毕销毁、StopPipeline 不改变节点连接、停止后不可再 RenderFrame 等前置条件与违反时错误码。",
            "mustResolve": true
          },
          {
            "topic": "返回值校验",
            "hint": "核对官方指南示例代码未包含返回值校验这一已知缺口，实施必须为每个 OHAudioSuite 调用补充返回值检查并按错误码分支处理；错误码含义以本次冻结 base.h/engine.h 为准。",
            "mustResolve": true
          }
        ],
        "conflictProbes": [
          {
            "id": "SA-S001-CP01",
            "topic": "REALTIME 模式效果节点支持范围",
            "positions": [
              "base.h/engine.h 参考：API 23 前 REALTIME 管线仅支持均衡器效果节点，API 23 及以后支持全部效果节点（含空间渲染）",
              "空间音频渲染指南：直接以 AUDIOSUITE_PIPELINE_REALTIME_MODE 搭配空间渲染节点给出完整示例，隐含要求 API version 23+"
            ]
          },
          {
            "id": "SA-S001-CP02",
            "topic": "管线与节点数量上限版本分档",
            "positions": [
              "engine.h/base.h：每引擎最多 10 条管线；实时预览管线在 API 26.0.0 前最多 1 条、之后不再单独限制但总数仍受 10 条约束",
              "engine.h/base.h：每管线输出节点有且仅 1、混音节点不超过 3；效果类节点 API 24 前上限 5 个、API 24 起上限 15 个，超限报数量限制错误"
            ]
          },
          {
            "id": "SA-S001-CP03",
            "topic": "RenderFrame 调用时机约束",
            "positions": [
              "engine.h：RenderFrame 须在管线运行态调用；所有输入 finishedFlag 置位后再调用返回 UNSUPPORTED_OPERATION；管线停止后不可再 RenderFrame",
              "指南示例代码未显式处理 finishedFlag 后与停止态的调用约束，也未检查返回值，直接照搬存在违规风险"
            ]
          }
        ]
      },
      "expectedOutcomeTemplates": [
        {
          "assertion": "在满足版本与数量约束的工程中，按官网流程创建引擎与 REALTIME 管线，组建输入、空间渲染、混音与唯一输出节点并连接，StartPipeline 后 RenderFrame 持续将渲染帧送至输出写数据回调实现实时预览；全部输入 finishedFlag 置位后停止渲染，StopPipeline 后按节点、管线、引擎顺序销毁且无泄漏；任一调用返回错误码时按错误分支处理。",
          "criteriaTopics": [
            "引擎与管线生命周期顺序",
            "节点创建与连接组网",
            "实时预览链路与 finishedFlag 语义",
            "构建链接与头文件引入",
            "REALTIME 模式与版本门槛",
            "管线与节点数量拓扑限制",
            "销毁前置条件",
            "返回值校验"
          ]
        }
      ],
      "implementation": {
        "steps": [
          "确认工程 API version 满足空间渲染门槛（以本次冻结官网为准，指南标注 23 起），CMakeLists 链接 libohaudio.so 与 libohaudiosuite.so，并引入 native_audio_suite_base.h、native_audio_suite_engine.h 及 ohaudio 相关头文件。",
          "按官网顺序创建引擎与 REALTIME 模式管线，用 NodeBuilder 依次构建输入（设置数据请求回调）、EFFECT_NODE_TYPE_SPACE_RENDER、混音与输出节点，CreateNode 后按官方拓扑 ConnectNodes 组网。",
          "启动管线后在输出节点写数据回调中调用 RenderFrame 实时预览；跟踪各输入 finishedFlag，全部置位后停止渲染，StopPipeline 后按节点、管线、引擎逆序销毁并释放 NodeBuilder。",
          "为每个 OHAudioSuite/OHAudio 调用补充返回值检查并按本次冻结的错误码分支处理，不照搬缺少返回值校验的示例代码。"
        ]
      },
      "staticRules": [
        {
          "id": "sa-s001-engine-create",
          "kind": "require_any",
          "patterns": [
            "OH_AudioSuiteEngine_Create\\s*\\("
          ],
          "onMissing": "failed",
          "message": "缺少 OHAudioSuite 引擎创建调用。"
        },
        {
          "id": "sa-s001-pipeline-create",
          "kind": "require_any",
          "patterns": [
            "OH_AudioSuiteEngine_CreatePipeline\\s*\\("
          ],
          "onMissing": "failed",
          "message": "缺少管线创建调用。"
        },
        {
          "id": "sa-s001-realtime-mode",
          "kind": "require_any",
          "patterns": [
            "AUDIOSUITE_PIPELINE_REALTIME_MODE"
          ],
          "onMissing": "failed",
          "message": "未声明 REALTIME 管线工作模式。"
        },
        {
          "id": "sa-s001-space-render-node",
          "kind": "require_any",
          "patterns": [
            "EFFECT_NODE_TYPE_SPACE_RENDER"
          ],
          "onMissing": "failed",
          "message": "缺少空间渲染效果节点类型。"
        },
        {
          "id": "sa-s001-nodebuilder",
          "kind": "require_any",
          "patterns": [
            "OH_AudioSuiteNodeBuilder_(Create|SetNodeType|SetRequestDataCallback)\\s*\\("
          ],
          "onMissing": "failed",
          "message": "缺少 NodeBuilder 节点构建流程。"
        },
        {
          "id": "sa-s001-connect-nodes",
          "kind": "require_any",
          "patterns": [
            "OH_AudioSuiteEngine_ConnectNodes\\s*\\("
          ],
          "onMissing": "failed",
          "message": "缺少节点连接组网调用。"
        },
        {
          "id": "sa-s001-render-frame",
          "kind": "require_any",
          "patterns": [
            "OH_AudioSuiteEngine_RenderFrame\\s*\\("
          ],
          "onMissing": "failed",
          "message": "缺少 RenderFrame 实时预览调用。"
        },
        {
          "id": "sa-s001-start-stop",
          "kind": "require_any",
          "patterns": [
            "OH_AudioSuiteEngine_(StartPipeline|StopPipeline)\\s*\\("
          ],
          "onMissing": "failed",
          "message": "缺少管线启动与停止控制。"
        },
        {
          "id": "sa-s001-destroy",
          "kind": "require_any",
          "patterns": [
            "OH_AudioSuiteEngine_(DestroyNode|DestroyPipeline|Destroy)\\s*\\("
          ],
          "onMissing": "failed",
          "message": "缺少节点/管线/引擎销毁清理。"
        },
        {
          "id": "sa-s001-link-libs",
          "kind": "require_any",
          "patterns": [
            "libohaudiosuite"
          ],
          "onMissing": "failed",
          "message": "构建脚本未链接 libohaudiosuite.so。"
        },
        {
          "id": "sa-s001-result-check",
          "kind": "require_any",
          "patterns": [
            "AUDIOSUITE_SUCCESS|AUDIOSUITE_ERROR_"
          ],
          "onMissing": "failed",
          "message": "缺少 OHAudioSuite 调用返回值/错误码检查。"
        }
      ],
      "negativeCases": [
        "在低于空间渲染版本门槛（指南标注 API 23）的工程中使用 EFFECT_NODE_TYPE_SPACE_RENDER 节点",
        "REALTIME 管线在 API 23 前接入非均衡器效果节点（含空间渲染节点）",
        "管线缺少输入节点、输出节点超过 1 个或混音节点超过上限仍启动",
        "效果节点数量超出当前 API 版本分档上限仍继续创建节点",
        "全部输入 finishedFlag 置位后继续调用 RenderFrame，或在管线非运行态调用 RenderFrame",
        "管线未 STOPPED 或节点仍处于处理路径时销毁节点",
        "未按官方顺序直接销毁引擎而未处理管线与节点的实现",
        "照搬官方示例代码而省略返回值校验"
      ],
      "requiredChecks": [
        "static",
        "sdk",
        "build",
        "install",
        "runtime"
      ],
      "demoValidation": {
        "layoutPolicy": "single_page_preferred",
        "points": [
